__pycache__/
*.pyc
*.xlsx

# Resultado del empaquetado (se publica en los releases, no en el repo)
dist/
build/migrador/
build/TERMINOS.txt
*.spec.bak

# Config local de la app (incluye la clave de la API del usuario)
.migrador-catalogos/

# Binarios de terceros que se descargan al compilar, no se versionan
build/terceros/ffmpeg
build/terceros/ffmpeg.exe
build/CON_AUDIO

# La clave de YouTube NUNCA entra al repositorio. Se genera al compilar, a
# partir de la variable MIGRADOR_CLAVE_YT (un secreto de GitHub en el CI).
build/terceros/clave_yt.dat

# Pagina temporal que usa build/capturas.py. Se borra sola al terminar, pero si
# el generador se corta a la mitad no tiene que quedar commiteada.
app/web/_capturas.html

# Harness temporales de desarrollo
_dev_*.py
_smoke*.py
